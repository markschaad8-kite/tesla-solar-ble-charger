# Shared secrets for systemd EnvironmentFile= (charger + relay).
#
# Copy to pi-zero-ble-relay/config.env (same relative path install.sh expects).
#
# Charger host: set BLE_RELAY_HOST to your Pi Zero static IP (avoid mDNS-only).
# Pi Zero relay: set TESLA_VIN, KEY_FILE, API_KEY, RELAY_PORT.

# --- Charger container (podman -e … from solar-charger.service) ---
TESLA_VIN=
TESLA_EMAIL=
BLE_RELAY_HOST=192.168.1.100

# --- Pi Zero BLE relay ---
KEY_FILE=/home/pi/pi-zero-ble-relay/private.pem
TESLA_CONTROL_PATH=/usr/local/bin/tesla-control
RELAY_PORT=5003
BLE_TIMEOUT=45

# Shared: relay HTTP API key (charger sends X-API-Key).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
