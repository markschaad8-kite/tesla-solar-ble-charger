# BLE relay + charger host environment (template).
#
# For a full Pi 5 + Pi Zero install, copy deploy/config.env.example from the
# repo root to pi-zero-ble-relay/config.env and fill in all values.
#
# Pi Zero only: minimum below.

TESLA_VIN=YOUR_VIN_HERE
KEY_FILE=/home/pi/pi-zero-ble-relay/private.pem
TESLA_CONTROL_PATH=/usr/local/bin/tesla-control
RELAY_PORT=5003
BLE_TIMEOUT=45
API_KEY=
