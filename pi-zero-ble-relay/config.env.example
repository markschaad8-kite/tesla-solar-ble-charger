# Tesla BLE Relay Configuration
# Copy this to config.env and edit with your values

# Your Tesla VIN (17 characters)
TESLA_VIN=YOUR_VIN_HERE

# Path to private key (copied from Pi 5)
KEY_FILE=/home/pi/pi-zero-ble-relay/private.pem

# Path to tesla-control binary
TESLA_CONTROL_PATH=/usr/local/bin/tesla-control

# Port to listen on
RELAY_PORT=5003

# BLE command timeout in seconds
BLE_TIMEOUT=45

# Optional: API key for authentication (leave empty to disable)
# If set, requests must include header: X-API-Key: your-key-here
API_KEY=
